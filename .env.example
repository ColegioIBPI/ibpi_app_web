# -----------------------------------------------------------------------------
# Portal IBPI — variáveis de ambiente
#
# Copie para `.env.local` (que está no .gitignore) e preencha com os valores
# do projeto Firebase `colegioibpi`. Os mesmos valores vão no painel da Vercel.
# -----------------------------------------------------------------------------

# Firebase — SDK cliente (navegador)
# Console do Firebase → Configurações do projeto → Seus apps → App da Web.
# Estas chaves são públicas por natureza: quem protege o dado são as
# Security Rules do Firestore, não o segredo destas variáveis.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=colegioibpi.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=colegioibpi
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=colegioibpi.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=438848489534
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase — Admin SDK (servidor)
# Console do Firebase → Configurações do projeto → Contas de serviço →
# Gerar nova chave privada. Cole o JSON inteiro em uma linha, ou o mesmo JSON
# em base64 (recomendado na Vercel, que não lida bem com quebra de linha).
#
# ATENÇÃO: esta chave dá acesso total ao projeto, ignorando as Security Rules.
# Nunca commite, nunca exponha no cliente.
FIREBASE_SERVICE_ACCOUNT=

# Migração do sistema Access (opcional — só para rodar os scripts locais)
# Caminho do arquivo .accdb exportado do sistema atual do colégio.
ACCESS_DB_PATH=
