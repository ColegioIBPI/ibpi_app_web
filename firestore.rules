rules_version = '2';

// Regras de segurança do Portal IBPI.
//
// Espelham a matriz de acesso do README (seção 3.1) e a implementação em
// `src/core/auth/roles.ts`. Ao mudar uma, mude a outra — e rode
// `npm run test:rules`.
//
// Duas decisões estruturais:
//
// 1. NENHUMA ESCRITA PELO CLIENTE. Todo lançamento de nota, falta, ocorrência
//    e cobrança passa por Server Action ou Route Handler usando o Admin SDK,
//    que valida perfil, escopo e grava a auditoria. Regra de escrita
//    permissiva no cliente tornaria a auditoria contornável.
//
// 2. O PERFIL VEM DO TOKEN. A `role` é uma custom claim aplicada pelo
//    servidor; o cliente não consegue forjá-la. Vínculos (filhos do
//    responsável, turmas do professor) vêm do documento em `users`, que o
//    próprio usuário não pode escrever.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- base

    function autenticado() {
      return request.auth != null && request.auth.token.role != null;
    }

    // `admin` passa em qualquer verificação de perfil.
    //
    // A regra mora aqui, e não repetida em cada `match`, porque toda regra
    // de leitura da equipe passa por esta função: acrescentar 'admin' a
    // vinte listas é como uma delas fica de fora, e o buraco só aparece no
    // dia em que alguém abre a tela e recebe "sem permissão".
    //
    // Isso **não** dá acesso ao que é da família: `ehProprioAluno` e
    // `ehFilho` exigem, além do perfil, uma matrícula ou um vínculo no
    // documento do usuário, que a conta de administração não tem. A chave
    // mestra abre as portas da escola, não a identidade de um aluno.
    function temPerfil(perfis) {
      return autenticado()
        && (request.auth.token.role == 'admin'
            || request.auth.token.role in perfis);
    }

    function secretariaOuCoordenacao() {
      return temPerfil(['secretaria', 'coordenacao']);
    }

    // Documento do próprio usuário: fonte dos vínculos. Custa uma leitura,
    // e é o preço de não confiar em nada que o cliente informa.
    function eu() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function ehProprioAluno(matricula) {
      return temPerfil(['aluno']) && eu().matricula == matricula;
    }

    function ehFilho(matricula) {
      return temPerfil(['responsavel'])
        && eu().alunosVinculados is list
        && matricula in eu().alunosVinculados;
    }

    function professorDaTurma(turmaId) {
      return temPerfil(['professor'])
        && eu().turmas is list
        && turmaId in eu().turmas;
    }

    // Alcance de aviso e de informação útil: os dois usam a mesma chave de
    // destino, então usam a mesma verificação.
    //
    // A chave `todos` vale sempre, mesmo para uma conta antiga que ainda não
    // tem `chavesDeAlcance`: sem esta linha, uma conta não sincronizada
    // deixaria de ver até o comunicado da escola inteira.
    function alcanca(chave) {
      return chave == 'todos'
        || (eu().chavesDeAlcance is list && chave in eu().chavesDeAlcance);
    }

    // ------------------------------------------------------------- usuários

    match /users/{uid} {
      // Cada um lê o próprio cadastro de acesso; secretaria e coordenação
      // leem todos, porque são elas que criam e corrigem as contas.
      allow read: if (autenticado() && request.auth.uid == uid)
                  || secretariaOuCoordenacao();
      allow write: if false;
    }

    // --------------------------------------------------------------- alunos

    match /alunos/{matricula} {
      // O financeiro lê o cadastro para contato e cobrança — mas não tem
      // acesso a nota, frequência nem ocorrência (ver adiante).
      allow read: if secretariaOuCoordenacao()
                  || temPerfil(['financeiro'])
                  || professorDaTurma(resource.data.turmaId)
                  || ehProprioAluno(matricula)
                  || ehFilho(matricula);
      allow write: if false;
    }

    match /responsaveis/{id} {
      allow read: if secretariaOuCoordenacao()
                  || (autenticado() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /professores/{id} {
      allow read: if secretariaOuCoordenacao()
                  || (autenticado() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // ----------------------------------------------- estrutura da escola

    // Turma, disciplina, sala e alocação não são dado pessoal: qualquer
    // pessoa autenticada pode ler, e é o que permite montar as telas sem
    // uma consulta privilegiada para cada rótulo.
    match /turmas/{id} {
      allow read: if autenticado();
      allow write: if false;
    }

    match /disciplinas/{id} {
      allow read: if autenticado();
      allow write: if false;
    }

    match /salas/{id} {
      allow read: if autenticado();
      allow write: if false;
    }

    // Catálogo do que a secretaria emite — declaração de matrícula, de
    // frequência, histórico. Não é dado pessoal: é a lista de onde a família
    // escolhe ao fazer um pedido, e ela precisa lê-la para escolher.
    //
    // Inclusive o que está fora da lista: um pedido antigo aponta para um
    // item que pode ter saído de circulação, e sem poder lê-lo a família
    // veria o próprio pedido sem nome.
    match /documentosSolicitaveis/{id} {
      allow read: if autenticado();
      allow write: if false;
    }

    match /alocacoes/{id} {
      allow read: if autenticado();
      allow write: if false;
    }

    match /matriculas/{id} {
      allow read: if secretariaOuCoordenacao()
                  || professorDaTurma(resource.data.turmaId)
                  || ehProprioAluno(resource.data.matricula)
                  || ehFilho(resource.data.matricula);
      allow write: if false;
    }

    // ----------------------------------------------------------- frequência

    match /frequenciaDiaria/{id} {
      allow read: if secretariaOuCoordenacao()
                  || professorDaTurma(resource.data.turmaId)
                  || ehProprioAluno(resource.data.matricula)
                  || ehFilho(resource.data.matricula);
      allow write: if false;
    }

    match /diarioClasse/{id} {
      allow read: if secretariaOuCoordenacao()
                  || professorDaTurma(resource.data.turmaId);
      allow write: if false;
    }

    // ---------------------------------------------------------- ocorrências

    match /ocorrencias/{id} {
      // O aluno não vê a própria ocorrência disciplinar: ela é tratada com o
      // responsável e a equipe escolar.
      allow read: if secretariaOuCoordenacao()
                  || professorDaTurma(resource.data.turmaId)
                  || ehFilho(resource.data.matricula);
      allow write: if false;
    }

    // ---------------------------------------------------------- notas

    match /notas/{id} {
      allow read: if secretariaOuCoordenacao()
                  || professorDaTurma(resource.data.turmaId)
                  || ehProprioAluno(resource.data.matricula)
                  || ehFilho(resource.data.matricula);
      allow write: if false;
    }

    match /boletins/{id} {
      allow read: if secretariaOuCoordenacao()
                  || professorDaTurma(resource.data.turmaId)
                  || ehProprioAluno(resource.data.matricula)
                  || ehFilho(resource.data.matricula);
      allow write: if false;
    }

    // ------------------------------------------------------------ financeiro

    match /cobrancas/{id} {
      // Professor e aluno não têm nada a ver com mensalidade.
      allow read: if secretariaOuCoordenacao()
                  || temPerfil(['financeiro'])
                  || ehFilho(resource.data.matricula);
      allow write: if false;
    }

    // O plano acordado na matrícula, em texto livre.
    //
    // O responsável lê o do próprio filho: é a condição que ele negociou, e
    // não saber o que foi combinado é justamente o que gera a ligação para a
    // secretaria. O **aluno não**, pela mesma razão que não vê o resto do
    // financeiro — mensalidade é assunto de quem paga.
    //
    // O id do documento é a matrícula, e a regra usa ele: assim o acesso não
    // depende de um campo dentro do documento estar preenchido.
    match /planosDePagamento/{matricula} {
      allow read: if secretariaOuCoordenacao()
                  || temPerfil(['financeiro'])
                  || ehFilho(matricula);
      allow write: if false;
    }

    // Anotação interna do financeiro sobre o aluno: "ligar dia 10", "pai
    // pediu prazo até a folha".
    //
    // Coleção separada do plano acordado **por causa desta regra**: a
    // Security Rule decide por documento, nunca por campo. No mesmo
    // documento, seria preciso escolher entre o responsável ler o recado
    // interno ou não ler o próprio plano.
    //
    // Nem a família nem o professor leem. A equipe escolar, sim — e o aluno
    // não aparece em lugar nenhum desta regra.
    match /anotacoesFinanceiras/{matricula} {
      allow read: if secretariaOuCoordenacao() || temPerfil(['financeiro']);
      allow write: if false;
    }

    // Itens contratados do ano: anuidade, matrícula, taxa de material,
    // dependência. Vieram da tabela `Fatos` do Access, cujo nome sugere
    // ocorrência disciplinar mas guarda financeiro.
    match /contratos/{id} {
      allow read: if secretariaOuCoordenacao()
                  || temPerfil(['financeiro'])
                  || ehFilho(resource.data.matricula);
      allow write: if false;
    }

    // --------------------------------------------------------------- avisos

    match /avisos/{id} {
      // A equipe escolar lê tudo: publica, confere e precisa saber o que já
      // foi comunicado, inclusive o que saiu do ar.
      //
      // A família lê o que a alcança. O alcance não é recalculado aqui: ele
      // vem pronto em `users/{uid}.chavesDeAlcance`, gravado pelo servidor a
      // partir de `features/avisos/domain/destinatarios.ts`.
      //
      // Refazer a conta nesta linguagem seria manter duas versões da mesma
      // regra, e divergir aqui significa aviso de uma família aparecendo
      // para outra. Além disso, regra do Firestore não percorre lista: a
      // partir de `alunosVinculados` não dá para montar a chave da turma de
      // cada filho.
      //
      // O aviso despublicado some para a família e continua para a equipe:
      // o que foi comunicado fica registrado.
      allow read: if temPerfil(['secretaria', 'coordenacao', 'professor', 'financeiro'])
                  || (autenticado()
                      && resource.data.ativo == true
                      && alcanca(resource.data.chave));
      allow write: if false;
    }

    // --------------------------------------------------- informações úteis

    match /informacoes/{id} {
      // Os cards com link da aba do app: horário das aulas, calendário
      // escolar, critérios de avaliação, proposta pedagógica.
      //
      // Mesmo alcance dos avisos, mesma verificação — o colégio pensa "para
      // quem isto vale" de um jeito só, e duas regras dizendo a mesma coisa
      // é como uma delas fica para trás.
      allow read: if temPerfil(['secretaria', 'coordenacao', 'professor', 'financeiro'])
                  || (autenticado()
                      && resource.data.ativo == true
                      && alcanca(resource.data.chave));
      allow write: if false;
    }

    // ------------------------------------------------------------ auditoria

    match /auditoria/{id} {
      // Trilha de auditoria é só de leitura, e só para quem administra.
      allow read: if secretariaOuCoordenacao();
      allow write: if false;
    }

    // ------------------------------------------------------------- fallback

    // Coleção nova nasce fechada. Sem isto, criar uma coleção na FASE 3 e
    // esquecer a regra deixaria os dados abertos.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
