{
  "name": "ibpi-portal-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:firebase": "node --env-file=.env.local scripts/check-firebase.mjs",
    "deploy:rules": "node --env-file=.env.local scripts/deploy-rules.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore --project ibpi-regras-teste \"vitest run --config vitest.rules.config.mts\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.6.0",
    "framer-motion": "^12.23.28",
    "google-auth-library": "^11.1.0",
    "lucide-react": "^0.552.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.66.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "firebase-tools": "^13.35.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true,
    "unrs-resolver@1.12.2": true
  }
}
